// T&T Digita - schema inicial (Fase 0: Fundacao).
// Cobre so o necessario para autenticacao e organizacao (docs/briefing.md secao 42).
// Trilhas, exercicios, tentativas, salas ao vivo e ranking entram nas fases seguintes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  role         Role
  status       UserStatus @default(ACTIVE)
  // Nulo para alunos (login por codigo, briefing secao 5). Obrigatorio/unico para staff.
  email        String?    @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?

  student     Student?
  teacher     Teacher?
  auditLogs   AuditLog[]
  hostedRooms LiveRoom[]

  @@index([role])
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  // Codigo de login: unico, normalizado (trim + lowercase) na aplicacao antes de gravar.
  code String @unique

  memberships            ClassMember[]
  attempts               Attempt[]
  keystrokeStats         KeystrokeStat[]
  liveRoomParticipations LiveRoomParticipant[]
  liveRoomRoundResults   LiveRoomRoundResult[]
  gameScores             GameScore[]
  profile                StudentProfile?
  cosmetics              StudentCosmetic[]
  achievements           StudentAchievement[]
  dailyActivities        DailyActivity[]
  seasonScores           SeasonScore[]

  createdAt DateTime @default(now())
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  classes Class[]

  createdAt DateTime @default(now())
}

model Class {
  id     String     @id @default(cuid())
  name   String
  course String?
  shift  String?
  status UserStatus @default(ACTIVE)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  members ClassMember[]

  createdAt DateTime @default(now())
}

model ClassMember {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([studentId, classId])
}

// --- Fase 1: motor de exercicio + trilha (docs/briefing.md secao 7-13) ---
// World = mundo do briefing secao 8. Exercise.order e unico dentro do mundo;
// a trilha visivel e so a cascata [world.order, exercise.order] em sequencia.

enum ExerciseType {
  KEY_SEQUENCE
  WORD_LIST
  BIGRAM
  PHRASE
  NUMBERS
  PROFESSIONAL_DATA
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum AttemptMode {
  PRACTICE
}

model World {
  id    String @id @default(cuid())
  title String
  focus String
  order Int    @unique

  exercises Exercise[]
  liveRooms LiveRoom[]

  createdAt DateTime @default(now())
}

model Exercise {
  id    String       @id @default(cuid())
  title String
  type  ExerciseType

  worldId String
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  // Sequencia de caracteres (KEY_SEQUENCE) ou palavras/frase separadas por
  // espaco (demais tipos). O tipo hoje e so rotulo -- a mecanica de digitacao
  // e a mesma pra todos.
  content     String
  allowedKeys String[]
  // "% definido pelo professor" pra avançar pro próximo exercício (ver
  // meetsUnlockBar em exercises/mastery.ts) -- 0.75 é o padrão quando o
  // professor não personaliza o valor pra este exercício.
  minAccuracy Float         @default(0.75)
  targetWpm   Int?
  // Quantas tentativas o sistema pede antes de considerar o exercicio
  // dominado, mesmo que a primeira ja bata a precisao minima -- repeticao
  // curta e domino gradual (briefing sec. 8 "Dominio" / referencia TypingClub).
  minAttempts Int           @default(2)
  order       Int
  status      ContentStatus @default(PUBLISHED)

  attempts Attempt[]

  createdAt DateTime @default(now())

  @@unique([worldId, order])
}

// Estatistica agregada por tecla (briefing secao 42/43: preferir agregado a
// log bruto). Base do "mapa de teclas fracas" (secao 50, CA17).
model KeystrokeStat {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  char     String
  attempts Int    @default(0)
  errors   Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([studentId, char])
}

model Attempt {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  mode AttemptMode @default(PRACTICE)

  startedAt  DateTime
  finishedAt DateTime
  durationMs Int

  expectedChars  Int
  typedChars     Int
  correctChars   Int
  incorrectChars Int
  backspaces     Int

  wpmRaw      Float
  wpmNet      Float
  accuracy    Float
  consistency Float

  formulaVersion String

  createdAt DateTime @default(now())

  @@index([studentId, exerciseId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}

// --- Fase 3: Competir (docs/briefing.md secao 24-26, 45) ---
// Sala ao vivo: professor/admin cria, gera codigo temporario, aluno entra e
// compete numa corrida sincronizada pelo servidor (tempo/pontuacao oficiais
// nao vem do cliente -- secao 25).

enum LiveRoomStatus {
  LOBBY
  COUNTDOWN
  RUNNING
  FINISHED
  CANCELLED
}

// Sala baseada em Mundo inteiro (rodada por exercicio, na ordem da trilha) ou
// em Jogo (rodada unica, todos jogam o mesmo GameType ao mesmo tempo) --
// nunca as duas coisas na mesma sala.
enum LiveRoomActivityType {
  WORLD
  GAME
}

model LiveRoom {
  id     String         @id @default(cuid())
  // Codigo curto de entrada, unico apenas enquanto a sala nao termina
  // (liberado depois -- secao 25 "codigo expira apos encerramento").
  code   String         @unique
  status LiveRoomStatus @default(LOBBY)

  activityType LiveRoomActivityType

  worldId  String?
  world    World?    @relation(fields: [worldId], references: [id], onDelete: Restrict)
  gameType GameType?

  // Ordenado; preenchido so quando activityType = WORLD (1 id de Exercise
  // por rodada). Snapshot da ordem do mundo no momento da criacao da sala --
  // nao e recalculado se o professor editar o mundo depois.
  roundExerciseIds String[] @default([])
  roundCount       Int      @default(1)
  // 0 = sala ainda nao comecou; 1..roundCount durante RUNNING.
  currentRound     Int      @default(0)

  hostUserId String
  hostUser   User   @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  startedAt  DateTime?
  finishedAt DateTime?

  roundResults LiveRoomRoundResult[]
  participants LiveRoomParticipant[]

  createdAt DateTime @default(now())

  @@index([worldId])
}

// Agregado final de um aluno numa sala -- persistido ao final para historico
// (secao 24, item 11). O resultado rodada-a-rodada mora em LiveRoomRoundResult;
// aqui so fica a soma de pontos e a colocacao final.
model LiveRoomParticipant {
  id String @id @default(cuid())

  roomId String
  room   LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  joinedAt    DateTime  @default(now())
  finishedAt  DateTime?
  totalPoints Int       @default(0)
  position    Int?

  createdAt DateTime @default(now())

  @@unique([roomId, studentId])
}

// Resultado de um aluno numa rodada especifica -- calculado a partir do
// Attempt validado pelo mesmo pipeline de metricas do modo pratica (rodada
// WORLD) ou do placar do minigame (rodada GAME, nao comparavel entre tipos
// de jogo diferentes -- serve so de desempate dentro da MESMA rodada).
model LiveRoomRoundResult {
  id String @id @default(cuid())

  roomId String
  room   LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  roundIndex Int // 1-based

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  wpmNet         Float?
  accuracy       Float?
  consistency    Float?
  incorrectChars Int?

  gameScore          Int?
  gameWordsCompleted Int?

  // Ja convertido pela regra de pontos-por-colocacao -- e isso que soma pro
  // placar da sala (LiveRoomParticipant.totalPoints), nao a metrica bruta.
  pointsAwarded Int
  position      Int?
  finishedAt    DateTime?

  @@unique([roomId, roundIndex, studentId])
}

// --- Fase 4: Jogar (docs/briefing.md secao 15) ---

enum GameType {
  ORBITAL
  ROBO
  CHUVA_PALAVRAS
  // DEFESA saiu do arcade (mecanica repetia o ORBITAL) e foi substituido por
  // FRUTA. O valor continua aqui de proposito: ja existem GameScore gravados
  // como DEFESA, e remover o valor do enum apagaria historico de aluno.
  DEFESA
  FRUTA
  RITMO
}

// Pontuacao de uma partida de jogo solo. Diferente de Attempt (que mede um
// exercicio de texto fixo), aqui a pontuacao vem de uma mecanica de jogo
// (combo, multiplicador, palavras completadas) calculada no cliente e so
// validada superficialmente no servidor -- sem sala ao vivo/ranking oficial
// envolvido ainda, o mesmo nivel de confianca do modo pratica (secao 46).
model GameScore {
  id String @id @default(cuid())

  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game      GameType

  score          Int
  wordsCompleted Int
  accuracy       Float
  durationMs     Int

  createdAt DateTime @default(now())

  @@index([studentId, game])
}

// --- Fase 5: Reter (docs/briefing.md secao 26-29) ---
// XP/nivel/moedas/sequencia sao vitalicios (StudentProfile). Pontos de liga
// sao por temporada (SeasonScore), zerados/recalculados a cada nova Season --
// secao 27: "usar pontos de temporada, separados do XP vitalicio".
// Catalogos de missao/conquista/cosmetico sao estaticos no codigo (nao ha
// tela de configuracao para superusuario nesta fase), so o progresso de cada
// aluno e persistido aqui.

enum League {
  BRONZE
  PRATA
  OURO
  PLATINA
  DIAMANTE
  MESTRE
  LENDA
}

enum CosmeticType {
  AVATAR_FRAME
  THEME
  TITLE
}

enum AchievementKey {
  FIRST_LESSON
  THOUSAND_WORDS
  TEN_THOUSAND_WORDS
  SEVEN_DAY_STREAK
  FIRST_DIAMOND_MASTERY
  FIRST_COMPETITION
  PERFECT_ACCURACY
  NEW_PERSONAL_RECORD
}

// Um por aluno. Contadores vitalicios (XP, nivel, moedas, sequencia, recorde).
model StudentProfile {
  studentId String  @id
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  xp                 Int       @default(0)
  level              Int       @default(1)
  coins              Int       @default(0)
  totalCorrectWords  Int       @default(0)
  bestWpmNet         Float     @default(0)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  distinctActiveDays Int       @default(0)
  // Data (meia-noite UTC) da ultima atividade valida, usada so pra calcular
  // sequencia (dia seguinte = +1, mesmo dia = mantem, qualquer salto = reseta).
  lastActiveDate     DateTime?

  equippedFrameId String?
  equippedThemeId String?
  equippedTitleId String?

  updatedAt DateTime @updatedAt
}

// Compra de um item do catalogo estatico de cosmeticos (id do catalogo, nao FK).
model StudentCosmetic {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  cosmeticId String
  type       CosmeticType

  purchasedAt DateTime @default(now())

  @@unique([studentId, cosmeticId])
}

model StudentAchievement {
  id String @id @default(cuid())

  studentId String
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  key       AchievementKey

  unlockedAt DateTime @default(now())

  @@unique([studentId, key])
}

// Contadores do dia (meia-noite UTC), base das missoes diarias e da
// sequencia/anti-farm de XP (secao 27: "limitar ganho repetitivo").
model DailyActivity {
  id String @id @default(cuid())

  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime

  exercisesCompleted   Int      @default(0)
  secondsTrained       Int      @default(0)
  accuracyGoalHit      Boolean  @default(false)
  weakKeyPracticed     Boolean  @default(false)
  roomJoined           Boolean  @default(false)
  personalBestImproved Boolean  @default(false)
  // Exercicios ja recompensados hoje (evita farmar XP repetindo o mesmo
  // exercicio varias vezes no mesmo dia).
  rewardedExerciseIds  String[] @default([])
  claimedMissionKeys   String[] @default([])
  // Teto diario de XP vindo de jogos soltos (anti-farm -- diferente dos
  // exercicios, jogos nao tem um "ja recompensei este" natural, entao o teto
  // e por XP acumulado no dia, nao por jogo especifico).
  gameXpEarnedToday    Int      @default(0)

  @@unique([studentId, date])
}

model Season {
  id       String    @id @default(cuid())
  index    Int       @unique
  startsAt DateTime
  endsAt   DateTime
  closedAt DateTime?

  scores SeasonScore[]

  createdAt DateTime @default(now())
}

model SeasonScore {
  id String @id @default(cuid())

  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  points    Int    @default(0)
  league    League @default(BRONZE)
  finalRank Int?

  updatedAt DateTime @updatedAt

  @@unique([seasonId, studentId])
}
