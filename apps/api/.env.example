# Copie para .env e preencha com os valores reais. Nunca commitar o .env real.

# Connection string do Postgres na Neon (https://neon.tech).
# Pegue em: Neon Console > seu projeto > Connect > "Prisma" (inclui ?sslmode=require).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/tt_digita?sslmode=require"

# Segredo usado para assinar o JWT de sessao. Gere um valor aleatorio forte, ex:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"

# Porta em que a API roda localmente.
PORT=3333

# Origem do frontend, usada para configurar CORS.
WEB_ORIGIN="http://localhost:3000"

NODE_ENV=development
